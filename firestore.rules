rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admins of Anatovia (verified Google accounts only).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['ibrahim1162006@gmail.com', 'anaselbieli@gmail.com']
        && request.auth.token.email_verified == true;
    }

    // A user may raise premiumUntil only by burning an unused code in the SAME write batch.
    function redeemOk() {
      let c = request.resource.data.lastCode;
      let codePath = /databases/$(database)/documents/codes/$(c);
      let base = (resource.data.get('premiumUntil', request.time) > request.time)
                   ? resource.data.get('premiumUntil', request.time) : request.time;
      return exists(codePath)
        && get(codePath).data.used == false
        && getAfter(codePath).data.used == true
        && getAfter(codePath).data.usedBy == request.auth.uid
        && request.resource.data.premiumUntil is timestamp
        && request.resource.data.premiumUntil <= base + duration.value(get(codePath).data.days, 'd') + duration.value(1, 'd');
    }

    // One free 3-day trial: needs a verified e-mail, never used before, not currently premium,
    // and a brand-new /trials/{deviceId} document created in the SAME write (one trial per device).
    function trialOk() {
      let dev = request.resource.data.get('trialDev', '');
      let tpath = /databases/$(database)/documents/trials/$(dev);
      return verified()
        && resource.data.get('trialUsed', false) == false
        && request.resource.data.get('trialUsed', false) == true
        && resource.data.get('premiumUntil', request.time) <= request.time
        && request.resource.data.premiumUntil is timestamp
        && request.resource.data.premiumUntil <= request.time + duration.value(4, 'd')
        && request.resource.data.trialAt == request.time
        && dev is string && dev.size() > 5
        && !exists(tpath) && existsAfter(tpath);
    }

    // Premium actions need a verified e-mail (Google accounts are always verified).
    function verified() { return request.auth.token.email_verified == true; }

    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow get, list: if isAdmin();

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'createdAt', 'devices', 'provider', 'verified', 'lastSeen'])
        && request.resource.data.devices.size() <= 2;

      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'createdAt', 'devices', 'premiumUntil', 'lastCode', 'provider', 'verified', 'lastSeen', 'trialUsed', 'trialAt', 'trialDev'])
        && request.resource.data.devices.size() <= 2
        && (resource.data.get('trialUsed', false) == false || request.resource.data.get('trialUsed', false) == true)
        && (request.resource.data.get('premiumUntil', null) == resource.data.get('premiumUntil', null) || (verified() && redeemOk()) || trialOk());

      allow update, delete: if isAdmin();
    }

    // Weekly leaderboard: each student writes only their own score doc; points never decrease and may only
    // grow ~1 per 3 s (+ small allowance); hard weekly cap = 40 points x 7 days.
    function scoreShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'name', 'pts', 'c', 'q', 't'])
        && d.uid == request.auth.uid
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 20
        && d.pts is int && d.pts >= 0 && d.pts <= 280
        && d.c is int && d.c >= 0 && d.c <= 5000
        && d.q is int && d.q >= d.c && d.q <= 5000
        && d.t == request.time;
    }
    // Leaderboard launch switch: config/board.open must be true (set from the admin page).
    function boardOpen() { return get(/databases/$(database)/documents/config/board).data.get('open', false) == true; }
    match /weeks/{wk}/scores/{uid} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid && verified()
        && boardOpen() && wk.matches('^[0-9]{8}$') && scoreShape() && request.resource.data.pts <= 40;
      allow update: if request.auth != null && request.auth.uid == uid && verified()
        && boardOpen() && scoreShape()
        && request.resource.data.pts >= resource.data.pts
        && request.resource.data.pts - resource.data.pts <= ((request.time.toMillis() - resource.data.t.toMillis()) / 3000) + 15;
      allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow update: if isAdmin();
    }

    match /config/{doc} {
      allow get: if true;
      allow write: if isAdmin();
    }

    match /trials/{dev} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create: if request.auth != null && verified()
        && request.resource.data.keys().hasOnly(['uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if isAdmin();
    }

    match /codes/{code} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create: if isAdmin() && request.resource.data.used == false;
      allow update: if isAdmin() || (
        request.auth != null && verified()
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt'])
        && request.resource.data.usedAt == request.time);
      allow delete: if isAdmin();
    }
  }
}
